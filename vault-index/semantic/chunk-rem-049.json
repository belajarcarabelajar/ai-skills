    {
      "id": "rationale--two-sided-normalization-or-every-edit-looks-like-drift",
      "label": "Markdown files use em dashes and typographic punctuation while the database stores ASCII, so without normalizing both sides every edit reports false drift",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-ai-skills/2026-09-25 - penambahan-follow-up-questions-ai-skill [ses_f25457c63ffeEts7uz91zl4SFu].md",
      "source_location": "L15886",
      "norm_label": "two-sided normalization or every edit looks like drift"
    },
    {
      "id": "rationale--unreachable-database-is-a-boundary-not-a-drift-failure",
      "label": "The snippet database does not exist on a CI runner, so a missing CLI is reported as unreachable and exits zero rather than as a content failure",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-ai-skills/2026-09-25 - penambahan-follow-up-questions-ai-skill [ses_f25457c63ffeEts7uz91zl4SFu].md",
      "source_location": "L15888",
      "norm_label": "unreachable database is a boundary not a drift failure"
    },
    {
      "id": "rationale--em-dash-removed-from-agent-facing-copy",
      "label": "Em dashes are replaced with hyphens before a snippet reaches the database because the master skill bans them in user-visible copy as reading as generative text",
