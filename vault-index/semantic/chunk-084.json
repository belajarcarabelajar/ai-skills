    {
      "id": "rationale--sentinel-retirement-collapses-sites",
      "label": "retiring the sentinel collapses 210 sites to one code",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-proyek-snipset/2026-09-26 - f2-retire-ok-or-sentinel [ses_f209be6e9ffeUzsjifu9sv5v3j].md",
      "source_location": "L33",
      "norm_label": "retiring the sentinel collapses 210 sites to one code",
      "statement": "Retiring the sentinel to a registered error code is the fix: it collapses 210 sites to one code, and it makes the rest of that arm worth scanning."
    },
    {
      "id": "rationale--no-user-visible-string-may-change",
      "label": "no user-visible string may change",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-proyek-snipset/2026-09-26 - f2-retire-ok-or-sentinel [ses_f209be6e9ffeUzsjifu9sv5v3j].md",
      "source_location": "L52",
      "norm_label": "no user-visible string may change",
      "statement": "No user-visible string may change. The english fallback must be byte-identical."
    },
    {
      "id": "rationale--domain-not-subsystem",
      "label": "the wire domain is database, not a subsystem",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-proyek-snipset/2026-09-26 - f2-retire-ok-or-sentinel [ses_f209be6e9ffeUzsjifu9sv5v3j].md",
      "source_location": "L11324",
      "norm_label": "the wire domain is database, not a subsystem",
      "statement": "The domain is database, not a subsystem, because the same DB mutex is missing for clipboard, snippets, notes, chat, speech, analytics, gamification, Vault, LAN transfer and tasks. Reusing the existing notes.database_not_initialized was rejected: it is a notes-only cold-start race with its own retry wording, so reuse would have changed a user-visible string and misattributed the subsystem."
    },
    {
      "id": "rationale--lazy-allocation-on-success-path",
      "label": "ok_or_else keeps the success path allocation-free",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-proyek-snipset/2026-09-26 - f2-retire-ok-or-sentinel [ses_f209be6e9ffeUzsjifu9sv5v3j].md",
      "source_location": "L11328",
      "norm_label": "ok_or_else keeps the success path allocation-free",
      "statement": "ok_or(\"...\") became ok_or_else(|| DATABASE_NOT_INITIALIZED.english.to_string()) because ok_or evaluates eagerly and would allocate even on success; laziness is preserved and the &str to String conversion keeps the error type identical, so no signature or error type changed."
    },
    {
      "id": "rationale--assertions-legitimately-spell-the-text",
      "label": "test assertions legitimately spell out the expected text",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-proyek-snipset/2026-09-26 - f2-retire-ok-or-sentinel [ses_f209be6e9ffeUzsjifu9sv5v3j].md",
      "source_location": "L2049",
      "norm_label": "test assertions legitimately spell out the expected text",
      "statement": "Only the exact returned-or-collected call shapes are banned, because test assertions legitimately still spell the expected text out; banning the bare literal would fail on assertions that are correct."
    },
    {
      "id": "rationale--repo-convention-locals-before-external",
      "label": "the repo convention puts local imports before external crates",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-proyek-snipset/2026-09-26 - f2-retire-ok-or-sentinel [ses_f209be6e9ffeUzsjifu9sv5v3j].md",
      "source_location": "L5449",
      "norm_label": "the repo convention puts local imports before external crates",
      "statement": "A survey of pre-existing import blocks found 105 put super/crate before external crates and only 3 did the opposite, and those 3 were exactly the files this sweep had just touched, so the dominant convention is local-first."
    },
    {
      "id": "rationale--parent-owns-frontend-dictionaries",
      "label": "the parent owns the frontend dictionaries",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-proyek-snipset/2026-09-26 - f2-retire-ok-or-sentinel [ses_f209be6e9ffeUzsjifu9sv5v3j].md",
      "source_location": "L11343",
      "norm_label": "the parent owns the frontend dictionaries",
      "statement": "every_code_is_covered_by_both_frontend_dictionaries will fail until both keys exist; the dictionaries are not this chunk's scope, so the chunk reported the exact wire string and english value and left the edit to the parent."
    },
