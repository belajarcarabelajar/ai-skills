    {
      "id": "rationale--sed-shadowing-rejected-because-sd-is-destructive-by-default",
      "label": "Shadowing sed with sd was rejected because `sed 's/a/A/' file` only prints while `sd a A file` overwrites the file, so a transparent wrapper would turn a read-only command into a destructive one",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-proyek-snipset/2026-09-24 - installing-typeless-2-2-0-deb-package [ses_f2bf9c1daffe7JAQPHDJTCsA7V].md",
      "source_location": "L27361",
      "norm_label": "shadowing sed with sd was rejected because `sed 's/a/a/' file` only prints while `sd a a file` overwrites the file, so a transparent wrapper would turn a read-only command into a destructive one"
    },
