    {
      "id": "rationale--required-related-is-a-contract-violation",
      "label": "requiring related turns a silent contract violation into a failure",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar/2026-09-26 - t9-vault-mirror-contract-test [ses_f21a1c467ffeZtDCHHZUzTrC7i].md",
      "source_location": "L47",
      "norm_label": "requiring related turns a silent contract violation into a failure",
      "statement": "The vault's Page Contract requires every active page to have at least one meaningful related page, and the publisher omits related only when a project's index file is missing, so requiring it converts a silent contract violation into a test failure. An earlier draft omitted related and would have let a mirror pass while violating the vault's own contract."
    },
    {
      "id": "rationale--pinning-stops-invented-values",
      "label": "pinning type and para stops invented vocabulary",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar/2026-09-26 - t9-vault-mirror-contract-test [ses_f21a1c467ffeZtDCHHZUzTrC7i].md",
      "source_location": "L39",
      "norm_label": "pinning type and para stops invented vocabulary",
      "statement": "Pinning type to note and para to project is what stops a future edit from inventing type: plan or reverting to para: projects; the two values are the measured vocabulary across 2757 vault files."
    },
    {
      "id": "rationale--block-style-related-unparseable",
      "label": "block-style related is unparseable from the frontmatter dict",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar/2026-09-26 - t9-vault-mirror-contract-test [ses_f21a1c467ffeZtDCHHZUzTrC7i].md",
      "source_location": "L2305",
      "norm_label": "block-style related is unparseable from the frontmatter dict",
      "statement": "related in block style parses to an empty string via vault_lint.parse_frontmatter because list items have no colon; presence still works, so at-least-one-related-link cannot be checked from the parsed dict and needs the raw-frontmatter helper."
    },
    {
      "id": "rationale--ambiguity-matches-the-linter",
      "label": "ambiguity stays unresolved because the linter agrees",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar/2026-09-26 - t9-vault-mirror-contract-test [ses_f21a1c467ffeZtDCHHZUzTrC7i].md",
      "source_location": "L2301",
      "norm_label": "ambiguity stays unresolved because the linter agrees",
      "statement": "vault_lint refuses to resolve a multi-candidate stem and leaves it in unresolved_targets, so the mirror test keeps that semantics; the publisher must emit fully qualified links, because Obsidian would guess too."
    },
    {
      "id": "rationale--ancestor-walk-covers-a-sibling-repo",
      "label": "the ancestor walk resolves a repo-relative source_path",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar/2026-09-26 - t9-vault-mirror-contract-test [ses_f21a1c467ffeZtDCHHZUzTrC7i].md",
      "source_location": "L2307",
      "norm_label": "the ancestor walk resolves a repo-relative source_path",
      "statement": "source_path is resolved tolerantly as absolute, ~, or relative to the note or vault or any ancestor of either; that ancestor walk is what makes a repo-relative docs/code-plan/plans/x.md resolve when the repo is a sibling of the vault, while garbage still resolves nowhere and fails."
    },
    {
      "id": "rationale--glob-scoped-to-project-plans",
      "label": "the discovery glob is scoped to project plans only",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar/2026-09-26 - t9-vault-mirror-contract-test [ses_f21a1c467ffeZtDCHHZUzTrC7i].md",
      "source_location": "L2303",
      "norm_label": "the discovery glob is scoped to project plans only",
      "statement": "The glob 01 - Projects/*/plans/*.md does not match the six existing plans at 01 - Projects/*/docs/code-plan/plans/*.md, so those are correctly out of scope; a publisher copying the repo's own docs/code-plan/plans layout would land in the wrong place and be silently untested."
    },
    {
      "id": "rationale--teeth-check-is-required-evidence",
      "label": "a suite that only ever skips is indistinguishable from a broken one",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar/2026-09-26 - t9-vault-mirror-contract-test [ses_f21a1c467ffeZtDCHHZUzTrC7i].md",
      "source_location": "L2311",
      "norm_label": "a suite that only ever skips is indistinguishable from a broken one",
      "statement": "A test that fails because a feature has not shipped is a broken test, so skip-with-a-stated-reason is right; but a suite that only ever skips is indistinguishable from a broken one, which is why three always-active tests exist and why the external teeth-check is the primary evidence the skipping assertions have teeth."
    },
    {
      "id": "rationale--unshipped-feature-is-a-broken-test",
      "label": "failing because a feature has not shipped makes a broken test",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar/2026-09-26 - t9-vault-mirror-contract-test [ses_f21a1c467ffeZtDCHHZUzTrC7i].md",
      "source_location": "L43",
      "norm_label": "failing because a feature has not shipped makes a broken test",
      "statement": "01 - Projects/*/plans/ does not exist yet, so the suite must not fail and must not error on a missing directory; it should skip and say so, because a test that fails merely because the feature has not shipped is a broken test."
    }
  ],
