    {
      "id": "rationale--focused-invisible-overlay-window-eats-clicks",
      "label": "Clicks vanish into an overlay window that is focused while the compositor reports it invisible, which is why the main window looks frozen",
      "file_type": "rationale",
      "source_file": "05 - Conversations/home-belajarcarabelajar-proyek-snipset/2026-09-23 - dukungan-appimage-snipset-di-arch-linux [ses_f307e386bffeYlPW4CvAW2eqoU].md",
      "source_location": "L16321",
      "norm_label": "clicks vanish into an overlay window that is focused while the compositor reports it invisible, which is why the main window looks frozen"
    },
