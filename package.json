    "plan:check": "bun scripts/ultra-plan-runner.mjs",
    "plan:run": "bun scripts/ultra-plan-runner.mjs --execute",
    "ci": "bash scripts/render-diagrams.sh && bun scripts/validate-skill.mjs && bun test scripts/"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.1.0",
  "license": "MIT"
}
